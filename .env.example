# Required backend settings
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
DB_NAME=nexusbet
JWT_SECRET=replace-with-a-long-random-secret
# Keep any existing values already configured in your current Render service
DATABASE_URL=
ODDS_API_KEY=
ODDS_REGIONS=eu
UPLOAD_DIR=uploads
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# AlphaPay automatic Ghana mobile money deposits
ALPHAPAY_API_KEY=sk_test_or_sk_live_key_from_AlphaPay
ALPHAPAY_BASE_URL=https://api.alphapay.me
ALPHAPAY_WEBHOOK_SECRET=webhook-signing-secret-from-AlphaPay
# Optional: change only if AlphaPay gives your merchant account a different verify route
ALPHAPAY_VERIFY_PATH_TEMPLATE=/v1/payments/verify/{reference}
# Optional return URL
ALPHAPAY_RETURN_URL=https://your-frontend-domain.example/wallet

# Existing deployment settings as required by your app
FRONTEND_URL=https://your-frontend-domain.example
CORS_ORIGINS=https://your-frontend-domain.example
